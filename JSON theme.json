{
  "name": "Finly Light \u2014 Power BI Compatible",
  "dataColors": [
    "#7A5AF8",
    "#F5B544",
    "#2FBF87",
    "#20B7B0",
    "#B79CFF",
    "#B3E04A",
    "#5B7CFA",
    "#F0556B"
  ],
  "good": "#2FBF87",
  "neutral": "#F5B544",
  "bad": "#F0556B",
  "maximum": "#7A5AF8",
  "center": "#2FBF87",
  "minimum": "#B79CFF",
  "null": "#8A87A6",
  "background": "#F2F1F8",
  "backgroundLight": "#FFFFFF",
  "backgroundNeutral": "#E8E7F1",
  "foreground": "#171436",
  "foregroundNeutralSecondary": "#8A87A6",
  "foregroundNeutralTertiary": "#8A87A6",
  "tableAccent": "#7A5AF8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#171436"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#171436"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#171436"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#8A87A6"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#171436"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "radius": 14
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 9,
            "lineColor": {
              "solid": {
                "color": "#E8E7F1"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDECF4"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 9
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "transparency": 0,
            "titleSize": 12,
            "searchTextSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F1F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F2F1F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "wordWrap": [
          {
            "show": false
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 10
          }
        ],
        "cardTitle": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 11
          }
        ],
        "card": [
          {
            "outline": "None",
            "barShow": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false,
            "shadeArea": true
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false,
            "shadeArea": true
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "labels": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "slices": [
          {
            "innerRadiusRatio": 72
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "rowPadding": 6,
            "outline": "None"
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F8FC"
              }
            },
            "urlIcon": true,
            "fontSize": 10,
            "outline": "None"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "rowPadding": 6,
            "outline": "None"
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A87A6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F8FC"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#171436"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "None",
            "fontSize": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E7F1"
              }
            },
            "radius": 20
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#7A5AF8"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualBorder": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#7A5AF8"
              }
            },
            "radius": 20
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "visualBorder": [
          {
            "show": false
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            },
            "fontSize": 28
          }
        ],
        "trendline": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#7A5AF8"
              }
            }
          }
        ],
        "goals": [
          {
            "show": false
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#171436"
              }
            }
          }
        ],
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#8A87A6"
              }
            }
          }
        ]
      }
    }
  }
}
